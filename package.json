{
  "name": "notification-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Node Version: 22.19.0",
  "main": "./src/server/index.ts",
  "scripts": {
    "lint": "eslint src",
    "format": "eslint src --fix",
    "script:run-schema-migration": "ts-node scripts/migrateSchema.ts",
    "script:wait-till-server-ready": "ts-node scripts/waitTillReady.ts",
    "script:insert-seed-data": "ts-node scripts/setupSeedData.ts",
    "script:create-hmac": "node scripts/createHmac.mjs",
    "script:tsoa": "tsoa spec-and-routes",
    "script:tsoa-routes-only": "tsoa routes",
    "script:start-docker": "docker-compose -p hub up -d",
    "script:stop-docker": "docker-compose -p hub down --remove-orphans",
    "prescript:start-docker": "npm run script:stop-docker",
    "script:start-test-docker": "docker-compose -f docker-compose.test.yml -p hub run --build test",
    "script:stop-test-docker": "docker-compose -f docker-compose.test.yml -p hub down --remove-orphans --volumes --rmi local",
    "script:copy-unit-report": "mv junit.xml unit-test-report.xml",
    "script:copy-e2e-report": "docker container cp $(docker container ls --all | grep -w test | awk '{print $1}'):./app/junit.xml ./e2e-test-report.xml",
    "script:copy-int-report": "docker container cp $(docker container ls --all | grep -w test | awk '{print $1}'):./app/junit.xml ./int-test-report.xml",
    "prescript:start-test-docker": "npm run script:stop-test-docker",
    "start:server-debug": "concurrently \"nodemon\" \"nodemon -x npm run script:tsoa -w src/server/controllers\" \"serverless offline start --config serverless.offline-sqs.yml\"",
    "prestart:server-debug": "npm run script:tsoa-routes-only && npm run script:start-docker && npm run script:insert-seed-data",
    "poststart:server-debug": "npm run script:stop-docker && pkill -f 'serverless offline'",
    "start:server": "ts-node src/server/Debuggable.ts",
    "start:server-bg": "ts-node src/server/Debuggable.ts &",
    "start:local": "concurrently \"ts-node src/server/Debuggable.ts &\" \"serverless offline start --config serverless.offline-sqs.yml\" \"nodemon -x npm run script:tsoa -w src/server/controllers\" \"npm run generate_api_docs\"",
    "prestart:local": "npm run script:tsoa-routes-only && npm run script:start-docker && npm run script:insert-seed-data",
    "poststart:local": "npm run script:stop-docker && pkill -f 'serverless offline'",
    "utest:watch": "npm run utest -- --watch",
    "utest:run": "jest --testRegex=tests/.*\\.utest\\.ts$ --collectCoverage --ci --reporters=default --reporters=jest-junit --silent",
    "utest": "npm-run-all utest:run script:copy-unit-report --continue-on-error",
    "docker-script:run-int-tests": "npm run inttest:run",
    "inttest:run": "jest --testRegex=.*\\.inttest\\.ts$ --runInBand --testTimeout=30000 --ci --reporters=default --reporters=jest-junit",
    "preinttest:run": "npm run script:tsoa-routes-only",
    "inttest": "npm-run-all \"script:start-test-docker npm run docker-script:run-int-tests\" script:copy-int-report script:stop-test-docker --continue-on-error",
    "docker-script:run-e2e-tests": "npm run e2etest:run",
    "e2etest:run": "jest --testRegex=.*\\.e2etest\\.ts$ --runInBand --testTimeout=30000 --ci --reporters=default --reporters=jest-junit --silent=false",
    "pree2etest:run": "npm run script:tsoa-routes-only && cross-env NODE_ENV=test npm run start:server-bg &&cross-env NODE_ENV=test serverless offline start --config serverless.offline-sqs.yml & npm run script:wait-till-server-ready",
    "poste2etest:run": "pkill -f 'serverless offline'",
    "e2etest": "npm-run-all \"script:start-test-docker npm run docker-script:run-e2e-tests\" script:copy-e2e-report script:stop-test-docker --continue-on-error",
    "config-credentials": "serverless config credentials --provider aws --key ${AWS_ACCESS_KEY_ID} --secret ${AWS_SECRET_ACCESS_KEY}",
    "deploy:staging": "npm run script:tsoa-routes-only && cross-env NODE_ENV=staging serverless deploy --config serverless.deploy.yml --verbose --debug=\"*\"",
    "deploy:prod": "npm run script:tsoa-routes-only && cross-env NODE_ENV=prod serverless deploy --config serverless.deploy.yml --verbose --debug=\"*\"",
    "generate_api_docs": "redocly build-docs src/server/routes/swagger.yaml --output='src/server/api-docs/notification_hub_api.html'"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.864.0",
    "@aws-sdk/client-lambda": "^3.886.0",
    "@aws-sdk/client-sns": "^3.1075.0",
    "@aws-sdk/client-sqs": "^3.886.0",
    "@aws-sdk/s3-request-presigner": "^3.894.0",
    "@pusher/push-notifications-server": "^1.2.7",
    "@sendgrid/mail": "^8.1.6",
    "@slack/web-api": "^7.2.0",
    "apns2": "^12.2.0",
    "axios": "^1.12.0",
    "cors": "2.8.5",
    "crypto-js": "4.2.0",
    "csv-parser": "^3.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^12.0.0",
    "google-auth-library": "^9.9.0",
    "jsonwebtoken": "^9.0.2",
    "keygen": "^0.4.0",
    "mongoose": "^8.18.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.10",
    "nodemon": "^3.1.0",
    "openai": "^4.67.3",
    "pusher": "^5.3.3",
    "selenium-webdriver": "^4.17.0",
    "serverless": "^3.40.0",
    "serverless-http": "^3.2.0",
    "ts-node": "^10.9.1",
    "tsoa": "^6.0.1",
    "twilio": "^5.3.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-typescript": "^7.23.3",
    "@tsoa/runtime": "^6.0.0",
    "@types/aws-lambda": "^8.10.134",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "4.2.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^18.19.20",
    "@types/nodemailer": "^6.4.14",
    "@types/selenium-webdriver": "^4.1.21",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "aws-sdk-client-mock": "^4.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "prompt-sync": "^4.2.0",
    "reflect-metadata": "^0.2.1",
    "serverless-domain-manager": "^7.4.0",
    "serverless-esbuild": "^1.51.0",
    "serverless-logging-config": "^1.0.2",
    "serverless-offline": "^13.3.3",
    "serverless-offline-sqs": "^8.0.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "tsyringe": "^4.8.0"
  },
  "_moduleAliases": {
    "@controllers": "src/server/controllers",
    "@routes": "src/server/routes",
    "@services": "src/server/services"
  }
}
